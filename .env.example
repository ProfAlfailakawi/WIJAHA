# GEMINI_API_KEY: Required for real Gemini AI pipeline calls (server-side only).
# When unset or AI_PROVIDER="mock", WIJAHA runs seamlessly using the deterministic mock provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL runtime variables (injected automatically by AI Studio Cloud SQL proxy)
SQL_HOST="/cloudsql/example-instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="placeholder_password"

# Cloud SQL PostgreSQL schema migration admin variables (used only by drizzle-kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="placeholder_admin_password"

# AI Pipeline Configuration ("auto" uses Gemini if GEMINI_API_KEY is valid, else "mock")
AI_PROVIDER="mock"
AI_MODEL_INTENT="gemini-4-hydrogen"
AI_MODEL_GENERATE="gemini-4-hydrogen"
AI_MODEL_EMBED="gemini-embedding-2"

# Billing & Email Providers ("mock" / "sandbox" / "console")
BILLING_PROVIDER="mock"
EMAIL_PROVIDER="console"

# Session & Field Encryption Secrets (dev fallbacks generated ephemeral in local dev only)
SESSION_SECRET="replace_with_32_byte_random_secret_in_production"
FIELD_ENCRYPTION_KEY="replace_with_32_byte_hex_key_in_production"
